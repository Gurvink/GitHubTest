					force_version = force_version,
					force_version_creation = force_version_creation,
					amplitude_enabled = amplitude_enabled,
					amplitude_region_lock = amplitude_region_lock,
					version = version,
					version_code = version_code,
					bundle_version = bundle_version,
				},
			}),
		},
	})
end)

local function show_custom_bundle_dialog()
	local default_platform, default_app_type, default_debug, default_amplitude_enabled, default_amplitude_region_lock, default_ab_testing_enabled, default_force_version_enabled, default_force_version, default_force_version_creation, ab_version_options = read_bundle_defaults()
	local default_version, default_version_code, default_bundle_version = read_project_version_defaults()
	local result = ui.show_dialog(custom_bundle_dialog({
		default_platform = default_platform,
		default_app_type = default_app_type,
		default_debug = default_debug,
		default_amplitude_enabled = default_amplitude_enabled,
		default_amplitude_region_lock = default_amplitude_region_lock,
		default_ab_testing_enabled = default_ab_testing_enabled,
		default_force_version_enabled = default_force_version_enabled,
		default_force_version = default_force_version,
		default_force_version_creation = default_force_version_creation,
		ab_version_options = ab_version_options,
		default_version = default_version,
		default_version_code = default_version_code,
		default_bundle_version = default_bundle_version,
	}))
	if not result then
		return
	end

	local ok, err = pcall(function()
		apply_patches(result)
		open_platform_bundle(result.platform)
	end)
	if not ok then
		print("Custom Bundle failed: " .. tostring(err))
		show_error("Custom Bundle failed:\n" .. tostring(err))
	end
end

function M.get_commands()
	return {
		{
			label = "CUSTOM BUNDLE",
			locations = { "Project" },
			run = function()
				show_custom_bundle_dialog()
			end,
		},
	}
end

return M
