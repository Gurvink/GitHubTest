local function is_macos_host()
	return editor.platform:sub(-#"macos") == "macos"
end

local function read_ab_version_options(ab_tester_text)
	local options = {}
	local open = ab_tester_text:find("M%.versions%s*=%s*%{")
	if not open then
		return { "DEFAULT" }
	end
	open = ab_tester_text:find("%{", open)
	if not open then
		return { "DEFAULT" }
	end

	local depth = 0
	local content_start = open + 1
	local content_end
	for i = open, #ab_tester_text do
		local c = ab_tester_text:sub(i, i)
		if c == "{" then
			depth = depth + 1
		elseif c == "}" then
			depth = depth - 1
			if depth == 0 then
				content_end = i - 1
				break
			end
		end
	end
	if not content_end then
		return { "DEFAULT" }
	end

	local content = ab_tester_text:sub(content_start, content_end)
	depth = 0
	for line in content:gmatch("[^\r\n]+") do
		local open_count = select(2, line:gsub("%{", ""))
		local close_count = select(2, line:gsub("%}", ""))
		if depth == 0 then
			local key = line:match("^%s*([%w_]+)%s*=%s*%{")
			if key then
				options[#options + 1] = key
			end
		end
		depth = depth + open_count - close_count
	end

	if #options == 0 then
		return { "DEFAULT" }
	end
	return options
end

local function read_bundle_defaults()
	local platform_text = editor.get(PLATFORM_PATH, "text")
	local platform_key = platform_text:match("local%s+currentplatform%s*=%s*PLATS%.([%w_]+)")
	local app_type_key = platform_text:match("local%s+currentapptype%s*=%s*APPTYPE%.([%w_]+)")

	local gamemanager_text = editor.get(GAMEMANAGER_PATH, "text")
	local bypass = gamemanager_text:match("M%.DEBUG_bypass_debug_check%s*=%s*(%a+)")

	local config_text = editor.get(CONFIG_PATH, "text")
	local amplitude_enabled_value = config_text:match("M%.amplitude_enabled%s*=%s*(%a+)")
	local amplitude_region_lock_value = config_text:match("M%.amplitude_region_lock%s*=%s*(%a+)")

	local ab_tester_text = editor.get(AB_TESTER_PATH, "text")
	local ab_testing_value = ab_tester_text:match("local%s+USE_AB_TESTING%s*=%s*(%a+)")
	local force_version_value = ab_tester_text:match("local%s+FORCE_VERSION%s*=%s*(%S+)")
	local force_version_creation_value = ab_tester_text:match("local%s+FORCE_VERSION_CREATION%s*=%s*(%a+)")
	local ab_version_options = read_ab_version_options(ab_tester_text)

	local platform = PLATS_TO_PLATFORM[platform_key] or "Windows"
	local app_type = APPTYPE_TO_APP_TYPE[app_type_key] or "Default"
	-- Debug toggle ON means bypass is false (debug mechanics enabled)
	local debug_enabled = bypass == "false"
	local amplitude_enabled = amplitude_enabled_value ~= "false"
	local amplitude_region_lock = amplitude_region_lock_value ~= "false"
	local ab_testing_enabled = ab_testing_value ~= "false"
	local force_version_enabled = force_version_value ~= nil and force_version_value ~= "nil"
	local force_version = force_version_value and force_version_value:match("M%.versions%.([%w_]+)") or ab_version_options[1]
	local force_version_creation = force_version_creation_value == "true"

	-- Prefer a version that still exists in M.versions
	local force_version_valid = false
	for i = 1, #ab_version_options do
		if ab_version_options[i] == force_version then
			force_version_valid = true
			break
		end
	end
	if not force_version_valid then
		force_version = ab_version_options[1]
	end

	return platform, app_type, debug_enabled, amplitude_enabled, amplitude_region_lock, ab_testing_enabled, force_version_enabled, force_version, force_version_creation, ab_version_options
end

local function read_project_version_defaults()
	local version = tostring(editor.get(GAME_PROJECT_PATH, "project.version") or "")
	local version_code = editor.get(GAME_PROJECT_PATH, "android.version_code")
	if type(version_code) ~= "number" then
		version_code = tonumber(version_code) or 0
	end
	local bundle_version = tostring(editor.get(GAME_PROJECT_PATH, "ios.bundle_version") or "")
	return version, version_code, bundle_version
end

local function patch_platform_settings(platform_label, app_type_label)
	local platform_key = PLATFORM_TO_PLATS[platform_label]
	if not platform_key then
		error("Unknown platform: " .. tostring(platform_label))
	end

	local app_type_key = APP_TYPE_TO_APPTYPE[app_type_label]
	if not app_type_key then
		error("Unknown app type: " .. tostring(app_type_label))
	end

	local text = editor.get(PLATFORM_PATH, "text")
	local new_text, platform_count = text:gsub(
		"(local%s+currentplatform%s*=%s*)PLATS%.[%w_]+",
		"%1PLATS." .. platform_key,
		1
	)
	if platform_count ~= 1 then
		error("Could not find local currentplatform assignment in platform.lua")
	end

	local final_text, app_type_count = new_text:gsub(
		"(local%s+currentapptype%s*=%s*)APPTYPE%.[%w_]+",
		"%1APPTYPE." .. app_type_key,
		1
	)
	if app_type_count ~= 1 then
		error("Could not find local currentapptype assignment in platform.lua")
	end

	local txs = {}
	if final_text ~= text then
		txs[#txs + 1] = editor.tx.set(PLATFORM_PATH, "text", final_text)
	end

	print("Custom Bundle: set currentplatform=PLATS." .. platform_key)
	print("Custom Bundle: set currentapptype=APPTYPE." .. app_type_key)
	return txs
end

