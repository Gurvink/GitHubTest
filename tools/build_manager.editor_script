local CONFIG = '.github/build.json'

local M = {}

local function load_config()
    local file = io.open(CONFIG, "r")

    if not file then
        return nil
    end

    local content = file:read("*a")
    file:close()

    local success, result = pcall(json.decode, content)

    if not success or type(result) ~= "table" then
        print("Failed to load build config")
        return nil
    end

    return result
end

local function initial_data(use_default)
    local saved = use_default ~= true and load_config() or nil

    local data = {
        version = saved and saved.version or "0.0.0",
        platforms = {}
    }

    for key, platform in pairs(PLATFORMS) do
        local saved_platform =
            saved
            and saved.platforms
            and saved.platforms[key]
            or {}

        local saved_settings =
            saved_platform.settings or {}

        local settings = {}
        local base = key:match("^[^_]+")

        for _, group in ipairs({
            COMMON_SETTINGS,
            PLATFORM_SETTINGS[base] or {},
            BUNDLE_SETTINGS
        }) do
            for _, setting in ipairs(group) do
                local value = saved_settings[setting.key]

                if value == nil then
                    value = setting.default
                end

                settings[setting.key] = value
            end
        end

        data.platforms[key] = {
            include = saved_platform.include == true,
            platform = platform,
            settings = settings
        }
    end

    return data
end



local function copy_with(data, key, value)
    local copy = {}
    for k, v in pairs(data) do
        copy[k] = v
    end
    copy[key] = value
    return copy
end

local function process_data(data, build)
    if not data then
        return nil
    end

    editor.create_directory('/.github')
    local file, err = io.open(CONFIG, 'w')
    if not file then error('Cannot write to' .. CONFIG .. ': ' .. tostring(err)) end
    file:write(json.encode(data))
    file:close()

    if build then
        for name, platform_data in pairs(data.platforms) do
            if platform_data.include then
                local platform = PLATFORMS[name]
                local settings = platform_data.settings
            end
        end
    end
end

local function to_relative_path(path)
    local root = editor.external_file_attributes(".").path

    root = root:gsub("\\", "/"):gsub("/+$", "")
    path = path:gsub("\\", "/"):gsub("/+$", "")

    local compare_root = root
    local compare_path = path

    if editor.platform == "x86_64-win32" then
        compare_root = root:lower()
        compare_path = path:lower()
    end

    if compare_path == compare_root then
        return "."
    end

    if compare_path:sub(1, #compare_root + 1)
        == compare_root .. "/" then
        return path:sub(#root + 2)
    end

    return nil
end

local function get_default_settings(platform, saved_settings)
    local data = {}

    for _, setting in ipairs(COMMON_SETTINGS) do
        data[setting.key] = setting.default
    end

    for _, setting in ipairs(PLATFORM_SETTINGS[platform] or {}) do
        data[setting.key] = setting.default
    end

    for key, value in pairs(saved_settings or {}) do
        data[key] = value
    end

    return data
end

local function get_ui_element(setting, value, on_value_changed)
    if setting.type == 'select' then
        return editor.ui.horizontal({
            grow = true,
            children = {
                editor.ui.label({
                    text = setting.label
                }),
                editor.ui.select_box({
                    value = value,
                    options = setting.options,
                    on_value_changed = on_value_changed
                })
            }
        })
    elseif setting.type == 'checkbox' then
        return editor.ui.check_box({
            text = setting.label,
            value = value == true,
            on_value_changed = on_value_changed
        })
    elseif setting.type == "directory"
        or setting.type == "file" then
        local is_directory = setting.type == "directory"

        return editor.ui.horizontal({
            grow = true,
            children = {
                editor.ui.label({
                    text = setting.label
                }),

                editor.ui.string_field({
                    value = value or "",
                    grow = true,
                    enabled = false
                }),

                editor.ui.button({
                    text = "Select",
                    on_pressed = function()
                        local opts = {
                            title = is_directory
                                and "Select Directory"
                                or "Select File"
                        }

                        if value and value ~= "" then
                            opts.path = value
                        end

                        local path

                        if is_directory then
                            path = editor.ui
                                .show_external_directory_dialog(opts)
                        else
                            path = editor.ui
                                .show_external_file_dialog(opts)
                        end

                        if path then
                            local relative = to_relative_path(path)

                            if relative then
                                on_value_changed(relative)
                            end
                        end
                    end
                })
            }
        })
    elseif setting.type == 'multiselect' then
        local children = {
            editor.ui.label({
                text = setting.label
            })
        }

        for _, option in ipairs(setting.options) do
            local selected_option = option
            local selected = false

            for _, current in ipairs(value or {}) do
                if current == selected_option then
                    selected = true
                    break
                end
            end

            children[#children + 1] = editor.ui.check_box({
                text = selected_option,
                value = selected,

                on_value_changed = function(checked)
                    local updated = {}

                    for _, current in ipairs(value or {}) do
                        if current ~= selected_option then
                            updated[#updated + 1] = current
                        end
                    end

                    if checked then
                        updated[#updated + 1] = selected_option
                    end

                    on_value_changed(updated)
                end
            })
        end

        return editor.ui.vertical({
            children = children
        })
    elseif setting.type == 'text' then
        return editor.ui.horizontal({
            grow = true,
            children = {
                editor.ui.label({
                    text = setting.label
                }),
                editor.ui.string_field({
                    value = value,
                    grow = true,
                    on_value_changed = on_value_changed
                })
            }
        })
    end
    return editor.ui.label({
        text = "Unknown setting type: " .. tostring(setting.type)
    })
end

local settings_popup = editor.ui.component(function(props)
    local data, set_data = editor.ui.use_state(get_default_settings, props.platform, props.saved_settings)

    local children = {}

    local function add_settings(settings)
        for _, setting in ipairs(settings) do
            local key = setting.key

            children[#children + 1] = get_ui_element(
                setting,
                data[key],
                function(value)
                    set_data(copy_with, key, value)
                end
            )
        end
    end

    add_settings(COMMON_SETTINGS)

    add_settings(PLATFORM_SETTINGS[props.platform] or {})

    add_settings(BUNDLE_SETTINGS)

    return editor.ui.dialog({
        title = props.platform .. " Settings",
        content = editor.ui.scroll({
            content = editor.ui.vertical({
                padding = editor.ui.PADDING.LARGE,
                children = children
            })
        }),
        buttons = {
            editor.ui.dialog_button({
                text = "Cancel",
                cancel = true
            }),
            editor.ui.dialog_button({
                text = "Save",
                default = true,
                result = { settings = data }
            })
        }
    })
end)

local popup = editor.ui.component(function(props)
    local data, set_data = editor.ui.use_state(initial_data)

    local function update(key, value)
        set_data(function(current)
            return copy_with(current, key, value)
        end)
    end

    local elements = {
        editor.ui.heading({
            text = 'Build settings'
        }),

        editor.ui.label({
            text = 'Game version'
        }),

        editor.ui.string_field({
            value = data.version,
            on_value_changed = function(value)
                update('version', value)
            end
        }),

        editor.ui.label({
            text = 'Platforms'
        }),
    }

    local rows = {}

    for name, platform in pairs(PLATFORMS) do
        local key = name

        rows[#rows + 1] = {
            editor.ui.check_box({
                text = key,
                value = data.platforms[key].include == true,

                on_value_changed = function(value)
                    set_data(function(current)
                        local platform_data = copy_with(
                            current.platforms[key], "include", value
                        )

                        local platforms = copy_with(
                            current.platforms, key, platform_data
                        )

                        return copy_with(
                            current, "platforms", platforms
                        )
                    end)
                end
            }),

            editor.ui.separator({}),

            editor.ui.button({
                text = "Settings",
                on_pressed = function()
                    local p = key:match("^[^_]+")

                    local result = editor.ui.show_dialog(
                        settings_popup({ platform = p, saved_settings = data.platforms[key].settings })
                    )

                    if result and result.settings then
                        set_data(function(current)
                            local platform_data = copy_with(
                                current.platforms[key],
                                "settings",
                                result.settings
                            )

                            local platforms = copy_with(
                                current.platforms,
                                key,
                                platform_data
                            )

                            return copy_with(
                                current,
                                "platforms",
                                platforms
                            )
                        end)
                    end
                end
            })
        }
    end

    elements[#elements + 1] = editor.ui.grid({
        columns = {
            { grow = true },
            {},
            {}
        },
        spacing = editor.ui.SPACING.MEDIUM,
        children = rows
    })

    return editor.ui.dialog({
        title = 'Defold build manager',
        width = 960,
        height = 690,
        resizable = true,

        content = editor.ui.scroll({
            content = editor.ui.vertical({
                padding = editor.ui.PADDING.LARGE,
                children = elements
            })
        }),

        buttons = {
            editor.ui.dialog_button({
                text = 'Save config',
                result = {
                    action = 'push',
                    build = false,
                    data = data
                }
            }),

            editor.ui.dialog_button({
                text = 'Save config and build',
                result = {
                    action = 'push',
                    build = true,
                    data = data
                }
            }),

            editor.ui.dialog_button({
                text = 'Clear config',
                result = {
                    action = 'clear',
                }
            }),

            editor.ui.dialog_button({
                text = 'Cancel',
                cancel = true
            }),
        }
    })
end)

function M.get_commands()
    return { {
        label = 'Build manager',
        locations = { 'Project' },

        run = function()
            local result = editor.ui.show_dialog(popup({}))

            if not result then
                print('Cancelled')
                return
            end

            if result.action == 'push' then
                process_data(result.data, result.build)
            elseif result.action == 'clear' then
                process_data(initial_data(true), false)
            end
        end
    } }
end

return M