	local app_type, set_app_type = ui.use_state(props.default_app_type or "Default")
	local debug_enabled, set_debug_enabled = ui.use_state(props.default_debug == true)
	local amplitude_enabled, set_amplitude_enabled = ui.use_state(props.default_amplitude_enabled ~= false)
	local amplitude_region_lock, set_amplitude_region_lock = ui.use_state(props.default_amplitude_region_lock ~= false)
	local ab_testing_enabled, set_ab_testing_enabled = ui.use_state(props.default_ab_testing_enabled ~= false)
	local force_version_enabled, set_force_version_enabled = ui.use_state(props.default_force_version_enabled == true)
	local force_version, set_force_version = ui.use_state(props.default_force_version or "DEFAULT")
	local force_version_creation, set_force_version_creation = ui.use_state(props.default_force_version_creation == true)
	local ab_version_options = props.ab_version_options or { "DEFAULT" }
	local version, set_version = ui.use_state(props.default_version or "")
	local version_code, set_version_code = ui.use_state(props.default_version_code or 0)
	local bundle_version, set_bundle_version = ui.use_state(props.default_bundle_version or "")

	local rows = {
		{
			ui.label({ text = "Platform", alignment = ui.ALIGNMENT.RIGHT }),
			ui.select_box({
				value = platform,
				options = PLATFORM_OPTIONS,
				on_value_changed = set_platform,
			}),
		},
		{
			ui.label({ text = "App type", alignment = ui.ALIGNMENT.RIGHT }),
			ui.select_box({
				value = app_type,
				options = APP_TYPE_OPTIONS,
				on_value_changed = set_app_type,
			}),
		},
		{
			ui.label({ text = "Debug", alignment = ui.ALIGNMENT.RIGHT }),
			ui.check_box({
				value = debug_enabled,
				text = "Enable debug mechanics",
				on_value_changed = set_debug_enabled,
			}),
		},
		{
			ui.label({ text = "AB Testing", alignment = ui.ALIGNMENT.RIGHT }),
			ui.check_box({
				value = ab_testing_enabled,
				text = "Enable AB Testing",
				on_value_changed = set_ab_testing_enabled,
			}),
		},
		{
			ui.label({ text = "Force version", alignment = ui.ALIGNMENT.RIGHT }),
			ui.check_box({
				value = force_version_enabled,
				text = "Force a specific AB version",
				on_value_changed = set_force_version_enabled,
			}),
		},
		{
			ui.label({ text = "Forced version", alignment = ui.ALIGNMENT.RIGHT }),
			ui.select_box({
				value = force_version,
				options = ab_version_options,
				enabled = force_version_enabled,
				on_value_changed = set_force_version,
			}),
		},
		{
			ui.label({ text = "Force creation", alignment = ui.ALIGNMENT.RIGHT }),
			ui.check_box({
				value = force_version_creation,
				text = "Force new version creation",
				on_value_changed = set_force_version_creation,
			}),
		},
		{
			ui.label({ text = "Version", alignment = ui.ALIGNMENT.RIGHT }),
			ui.string_field({
				value = version,
				on_value_changed = set_version,
			}),
		},
	}

	if platform == "Android" then
		rows[#rows + 1] = {
			ui.label({ text = "Version code", alignment = ui.ALIGNMENT.RIGHT }),
			ui.integer_field({
				value = version_code,
				on_value_changed = set_version_code,
			}),
		}
	elseif platform == "iOS" then
		rows[#rows + 1] = {
			ui.label({ text = "Bundle version", alignment = ui.ALIGNMENT.RIGHT }),
			ui.string_field({
				value = bundle_version,
				on_value_changed = set_bundle_version,
			}),
		}
	end

	rows[#rows + 1] = {
		ui.label({ text = "Amplitude", alignment = ui.ALIGNMENT.RIGHT }),
		ui.check_box({
			value = amplitude_enabled,
			text = "Enable Amplitude analytics",
			on_value_changed = set_amplitude_enabled,
		}),
	}
	rows[#rows + 1] = {
		ui.label({ text = "Region lock", alignment = ui.ALIGNMENT.RIGHT }),
		ui.check_box({
			value = amplitude_region_lock,
			text = "Limit Amplitude to USA and Georgia",
