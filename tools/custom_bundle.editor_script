local function patch_ab_testing(ab_testing_enabled, force_version_enabled, force_version, force_version_creation)
	local ab_testing_value = ab_testing_enabled and "true" or "false"
	local force_version_value = force_version_enabled and ("M.versions." .. force_version) or "nil"
	local force_version_creation_value = force_version_creation and "true" or "false"
	local text = editor.get(AB_TESTER_PATH, "text")

	local new_text, ab_testing_count = text:gsub(
		"local%s+USE_AB_TESTING%s*=%s*%S+",
		"local USE_AB_TESTING = " .. ab_testing_value,
		1
	)
	if ab_testing_count ~= 1 then
		error("Could not find local USE_AB_TESTING assignment in A_B_tester.lua")
	end

	local after_force_version, force_version_count = new_text:gsub(
		"local%s+FORCE_VERSION%s*=%s*%S+",
		"local FORCE_VERSION = " .. force_version_value,
		1
	)
	if force_version_count ~= 1 then
		error("Could not find local FORCE_VERSION assignment in A_B_tester.lua")
	end

	local final_text, force_creation_count = after_force_version:gsub(
		"local%s+FORCE_VERSION_CREATION%s*=%s*%S+",
		"local FORCE_VERSION_CREATION = " .. force_version_creation_value,
		1
	)
	if force_creation_count ~= 1 then
		error("Could not find local FORCE_VERSION_CREATION assignment in A_B_tester.lua")
	end

	local txs = {}
	if final_text ~= text then
		txs[#txs + 1] = editor.tx.set(AB_TESTER_PATH, "text", final_text)
	end

	print("Custom Bundle: set USE_AB_TESTING=" .. ab_testing_value)
	print("Custom Bundle: set FORCE_VERSION=" .. force_version_value)
	print("Custom Bundle: set FORCE_VERSION_CREATION=" .. force_version_creation_value)
	return txs
end

local function patch_custom_api_sandbox()
	-- Builds must always use the production API, never the sandbox.
	local text = editor.get(CUSTOM_API_PATH, "text")
	local new_text, count = text:gsub(
		"local%s+USE_SANDBOX_ENVIRONMENT%s*=%s*%S+",
		"local USE_SANDBOX_ENVIRONMENT = false",
		1
	)
	if count ~= 1 then
		error("Could not find local USE_SANDBOX_ENVIRONMENT assignment in custom_API.lua")
	end

	local txs = {}
	if new_text ~= text then
		txs[#txs + 1] = editor.tx.set(CUSTOM_API_PATH, "text", new_text)
	end

	print("Custom Bundle: set USE_SANDBOX_ENVIRONMENT=false")
	return txs
end

local function patch_game_project(platform_label, version, version_code, bundle_version)
	local txs = {}
	local current_version = tostring(editor.get(GAME_PROJECT_PATH, "project.version") or "")
	if version ~= current_version then
		txs[#txs + 1] = editor.tx.set(GAME_PROJECT_PATH, "project.version", version)
	end

	if platform_label == "Android" then
		local code = tonumber(version_code) or 0
		local current_code = editor.get(GAME_PROJECT_PATH, "android.version_code")
		if type(current_code) ~= "number" then
			current_code = tonumber(current_code) or 0
		end
		if code ~= current_code then
			txs[#txs + 1] = editor.tx.set(GAME_PROJECT_PATH, "android.version_code", code)
		end
	elseif platform_label == "iOS" then
		local current_bundle = tostring(editor.get(GAME_PROJECT_PATH, "ios.bundle_version") or "")
		if bundle_version ~= current_bundle then
			txs[#txs + 1] = editor.tx.set(GAME_PROJECT_PATH, "ios.bundle_version", bundle_version)
		end
	end

	return txs
end

local function apply_patches(result)
	local txs = {}
	local platform_txs = patch_platform_settings(result.platform, result.app_type)
	for i = 1, #platform_txs do
		txs[#txs + 1] = platform_txs[i]
	end
	local gamemanager_txs = patch_gamemanager_debug(result.debug_enabled)
	for i = 1, #gamemanager_txs do
		txs[#txs + 1] = gamemanager_txs[i]
	end
	local amplitude_txs = patch_amplitude_settings(result.amplitude_enabled, result.amplitude_region_lock)
	for i = 1, #amplitude_txs do
		txs[#txs + 1] = amplitude_txs[i]
	end
	local ab_testing_txs = patch_ab_testing(
		result.ab_testing_enabled,
		result.force_version_enabled,
		result.force_version,
		result.force_version_creation
	)
	for i = 1, #ab_testing_txs do
		txs[#txs + 1] = ab_testing_txs[i]
	end
	local sandbox_txs = patch_custom_api_sandbox()
	for i = 1, #sandbox_txs do
		txs[#txs + 1] = sandbox_txs[i]
	end
	local project_txs = patch_game_project(
		result.platform,
		result.version,
		result.version_code,
		result.bundle_version
	)
	for i = 1, #project_txs do
		txs[#txs + 1] = project_txs[i]
	end
	if #txs > 0 then
		editor.transact(txs)
		editor.save()
	end
end

local function show_error(message)
	ui.show_dialog(ui.dialog({
		title = "CUSTOM BUNDLE",
		content = ui.vertical({
			padding = ui.PADDING.LARGE,
			children = {
				ui.paragraph({ text = message }),
			},
		}),
		buttons = {
			ui.dialog_button({ text = "OK", default = true, cancel = true }),
		},
	}))
end

local function open_platform_bundle(platform_label)
	if platform_label == "iOS" and not is_macos_host() then
		show_error("iOS bundling is only available on macOS.")
		return
	end

	local launcher_key = PLATFORM_TO_LAUNCHER[platform_label]
	local launcher = launchers[launcher_key]
	if not launcher then
		error("No bundle launcher for platform: " .. tostring(platform_label))
	end

	-- true = show the normal Bundle dialog (same prefs keys as Project → Bundle)
	launcher(true)
end

